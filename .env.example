# Use 127.0.0.1 (not localhost) on Windows — Docker Desktop IPv6 publish hangs for node-pg.
DATABASE_URL=postgresql://emdr:emdr@127.0.0.1:5434/emdr

# Auth (generate: openssl rand -base64 32)
AUTH_SECRET=
# Local: http://localhost:3471 — tunnel: https://dev.nurahelp.com
APP_URL=http://localhost:3471

# Passkeys / WebAuthn (defaults from APP_URL hostname/origin)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3471
# Behind Cloudflare tunnel (dev.nurahelp.com):
# WEBAUTHN_RP_ID=dev.nurahelp.com
# WEBAUTHN_ORIGIN=https://dev.nurahelp.com

# Google Sign-In (OAuth Web client). Required in production.
# Dev may fall back to GMAIL_CLIENT_ID/SECRET if these are unset.
# Add authorized redirect URIs in Google Cloud Console:
#   http://localhost:3471/api/auth/google/callback
#   https://dev.nurahelp.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery is Admin → Email (Sender, Brevo, Gmail).
# Blank secrets below copy once into those settings, then sending ignores them.
# GMAIL_CLIENT_ID/SECRET also back up Google Sign-In when GOOGLE_CLIENT_* is unset.
BREVO_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Stripe — prefer Admin → Billing (sandbox + live + demo mode checkbox).
# Optional one-time bootstrap if Admin fields are empty:
# Sandbox / test (used when Demo mode is on):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_WEEKLY=
# STRIPE_PRICE_ID_MONTHLY=
# STRIPE_PRICE_ID_YEARLY=
# STRIPE_PUBLISHABLE_KEY=
# Live (used when Demo mode is off):
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_LIVE_WEBHOOK_SECRET=
# STRIPE_LIVE_PRICE_ID_WEEKLY=
# STRIPE_LIVE_PRICE_ID_MONTHLY=
# STRIPE_LIVE_PRICE_ID_YEARLY=
# STRIPE_LIVE_PUBLISHABLE_KEY=

# Shared secret for /api/cron/* (trial reminders, trial feedback, post-trial
# check-in, guest transcripts). Generate: openssl rand -base64 32
CRON_SECRET=

# Set to true when behind a trusted reverse proxy (nginx, Cloudflare Tunnel, etc.)
TRUST_PROXY=

# Google AdSense client id (optional). Script loads only for trial users when
# ads are enabled in Admin → Platform (not for paying users).
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# Cloudflare Turnstile (auth forms). Secret never goes in NEXT_PUBLIC_*.
# Widget domains must include each hostname in TURNSTILE_HOSTNAMES for that deploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEwsZmygyW6qxk-M
TURNSTILE_SECRET=
# Local / tunnel: localhost,127.0.0.1,dev.nurahelp.com
# Production: nurahelp.com,www.nurahelp.com (match Turnstile widget hostnames in CF dashboard)
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,dev.nurahelp.com,nurahelp.com,www.nurahelp.com
# Optional: siteverify timeout ms (default 25000). Raise if register/login 403 after ~10s.
# TURNSTILE_SITEVERIFY_TIMEOUT_MS=30000
# Local only: skip siteverify when challenges.cloudflare.com is slow or blocked (never in prod).
# TURNSTILE_BYPASS_DEV=true

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Google Ads MCP (mcp/google-ads-server.ts). Server-only. Never commit values.
# Cherry Studio starts `npx tsx mcp/google-ads-server.ts` from this repo.
# The process reads this file. Do not paste these into the agent prompt.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_CONVERSION_ACTION_ID=

# Meta Ads on Admin → Overview. Server-only. Leave empty to fall back to the
# Conversions API token stored on Connections.
META_ADS_ACCOUNT_ID=
META_ADS_ACCESS_TOKEN=
# App id and secret let a user token refresh itself before it expires.
META_APP_ID=
META_APP_SECRET=

# Server-side conversion tracking (docs/conversions.md).
# Credentials live in Admin → SEO → Connections, not here — they are stored in
# the database so they can be changed without a redeploy.
#
# Optional: route GA4 sends through Google's validating endpoint while setting
# up. It checks the payload shape only, never the API secret.
# GA4_MP_DEBUG=1

# Cloudinary — prefer Admin → Media → Settings.
# Optional bootstrap if those fields are empty:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Cloudflare edge purge after marketing saves (section, layout, media replace).
# Public pages are cached at Cloudflare (s-maxage=3600); without these an admin
# save keeps showing the old page until the next deploy purge. Same names as the
# CI purge step. Token needs Zone > Cache Purge > Purge. Unset = no-op (local dev).
# CF_ZONE_ID=
# CF_API_TOKEN=
