DATABASE_URL=postgresql://emdr:emdr@localhost:5434/emdr

# Auth (generate: openssl rand -base64 32)
AUTH_SECRET=
# Local: http://localhost:3471 — tunnel: https://dev.nurahelp.com
APP_URL=http://localhost:3471

# Passkeys / WebAuthn (defaults from APP_URL hostname/origin)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3471
# Behind Cloudflare tunnel (dev.nurahelp.com):
# WEBAUTHN_RP_ID=dev.nurahelp.com
# WEBAUTHN_ORIGIN=https://dev.nurahelp.com

# Google Sign-In (OAuth Web client). Required in production.
# Dev may fall back to GMAIL_CLIENT_ID/SECRET if these are unset.
# Add authorized redirect URIs in Google Cloud Console:
#   http://localhost:3471/api/auth/google/callback
#   https://dev.nurahelp.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — prefer Admin → Email (Brevo + Gmail + send-as). Optional .env bootstrap:
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=hi@contact.nurahelp.com
EMAIL_FROM_NAME=Nura

# Email — Gmail API (fallback when Brevo is missing or hits quota).
# Send-as / OAuth also editable in Admin → Email.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=hi@contact.nurahelp.com

# Stripe — prefer Admin → Billing (sandbox + live + demo mode checkbox).
# Optional one-time bootstrap if Admin fields are empty:
# Sandbox / test (used when Demo mode is on):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_WEEKLY=
# STRIPE_PRICE_ID_MONTHLY=
# STRIPE_PRICE_ID_YEARLY=
# STRIPE_PUBLISHABLE_KEY=
# Live (used when Demo mode is off):
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_LIVE_WEBHOOK_SECRET=
# STRIPE_LIVE_PRICE_ID_WEEKLY=
# STRIPE_LIVE_PRICE_ID_MONTHLY=
# STRIPE_LIVE_PRICE_ID_YEARLY=
# STRIPE_LIVE_PUBLISHABLE_KEY=

# Set to true when behind a trusted reverse proxy (nginx, Cloudflare Tunnel, etc.)
TRUST_PROXY=

# Google AdSense client id (optional). Script loads only for trial users when
# ads are enabled in Admin → Platform (not for paying users).
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# Cloudflare Turnstile (auth forms). Secret never goes in NEXT_PUBLIC_*.
# Widget domains must include each hostname in TURNSTILE_HOSTNAMES for that deploy.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEwsZmygyW6qxk-M
TURNSTILE_SECRET=
# Local / tunnel: localhost,127.0.0.1,dev.nurahelp.com
# Production: nurahelp.com,www.nurahelp.com
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,dev.nurahelp.com

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Server-side conversion tracking (see docs/conversions.md).
# The Stripe webhook reports the first real charge to these platforms, because
# a 7-day trial means the money moves days after the browser is gone.
# Every channel is skipped when its credentials are missing.
#
# GA4 Measurement Protocol — secret from Admin → Data streams → your web stream
# → Measurement Protocol API secrets. Measurement id is reused from Admin → SEO.
GA4_API_SECRET=
# GA4_MEASUREMENT_ID=
# GA4_MP_DEBUG=1  # route sends through /debug/mp/collect for validation
#
# Meta Conversions API — dataset access token from Events Manager → Settings.
META_PIXEL_ID=1120650977294654
META_CAPI_ACCESS_TOKEN=
# META_TEST_EVENT_CODE=
#
# Google Ads offline conversions — the only channel that credits the exact click.
# Needs a developer token, an OAuth client, and a refresh token with the
# https://www.googleapis.com/auth/adwords scope.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=   # only when the action lives under a manager account
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_ADS_API_VERSION=v21
